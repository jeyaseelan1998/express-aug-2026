PORT=6001
# Base URL used in the Swagger "servers" list; defaults to http://localhost:${PORT} if unset
APP_URL=
MONGODB_URI=mongodb://localhost:27017/express-aug-2026
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1d
COOKIE_MAX_AGE_MS=86400000
# Set to 'production' in every deployed environment. Controls the Secure flag
# on auth cookies and the SameSite default below.
NODE_ENV=
# Set 'true' when the browser frontend is served from a DIFFERENT site than
# this API (e.g. frontend on vercel.app, API on its own domain). That forces
# SameSite=None; Secure, without which the browser silently drops the auth
# cookie. Leave unset to follow NODE_ENV: cross-site in production, Lax in dev.
COOKIE_CROSS_SITE=

# Every browser origin allowed to call this API. Deployed environments must
# list the real frontend origin(s); credentialed cookie auth cannot use '*'.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=novamart-ecom-expres-api
AWS_MAX_UPLOAD_SIZE=5
# Lifetime (seconds) of presigned media download URLs; defaults to 300
AWS_SIGNED_URL_TTL=300
