PORT=6001
# Base URL used in the Swagger "servers" list; defaults to http://localhost:${PORT} if unset
APP_URL=
MONGODB_URI=mongodb://localhost:27017/express-aug-2026
JWT_SECRET=change-this-secret
# How long a sign-in lasts. Clients receive the matching `expiresAt` and drop
# their stored token then.
JWT_EXPIRES_IN=1d
# Which proxies are trusted to report the client IP (X-Forwarded-For), used by
# the login history. Default 'loopback' suits Nginx/Caddy on the same server.
# Use 1 behind a platform load balancer (Render, Railway, Heroku). See
# src/config/proxy.js for the other options.
TRUST_PROXY=loopback
# Days a login history row is kept before MongoDB expires it; defaults to 90
LOGIN_HISTORY_RETENTION_DAYS=90
# Set to 'production' in every deployed environment.
NODE_ENV=

# Every browser origin allowed to call this API. Deployed environments must
# list the real frontend origin(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=novamart-ecom-expres-api
AWS_MAX_UPLOAD_SIZE=5
# Lifetime (seconds) of presigned media download URLs; defaults to 300
AWS_SIGNED_URL_TTL=300
